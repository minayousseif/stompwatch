# Camera login. Copy to /etc/stompwatch/camera.env, fill it in, then:
#
#   sudo chown stompwatch:audio /etc/stompwatch/camera.env
#   sudo chmod 0600 /etc/stompwatch/camera.env
#
# The password lives here and nowhere else. It is never in stompwatch.conf,
# never in the database, and never in a log line, an error message, or an
# answer from the dashboard (SPEC.md section 3). The collector refuses to start if
# this file is readable by anyone but the service user.
#
# The systemd unit loads it with EnvironmentFile=-/etc/stompwatch/camera.env,
# so the service finds it on its own. The commands you run by hand do not
# read it unless you name it in stompwatch.conf:
#
#   camera_credentials_file = /etc/stompwatch/camera.env
#
# Format: KEY=value, one per line. No quotes, no spaces around the =, and
# no export. A value may hold spaces; everything after the = is the value.

CAMERA_USER=admin
CAMERA_PASS=
